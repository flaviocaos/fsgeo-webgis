# Copie para .env e ajuste. Em produção, troque TODOS os segredos.
ENVIRONMENT=development
DATABASE_URL=postgresql://webgis:webgis@localhost:5432/webgis
REDIS_URL=redis://localhost:6379/0

# Autenticação: "supabase" (produção) ou "local" (desenvolvimento, usuário único)
AUTH_MODE=local
LOCAL_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
DEV_USER_EMAIL=dev@fsgeo.com.br
DEV_USER_PASSWORD=troque-esta-senha
# Supabase: URL do projeto. Chaves assimétricas (padrão atual) são lidas do JWKS automaticamente.
SUPABASE_URL=
# Só para projetos Supabase que ainda usam o segredo JWT HS256 (legado):
SUPABASE_JWT_SECRET=

# Armazenamento: "local" ou "s3" (MinIO, AWS S3, Cloudflare R2...)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_BUCKET=webgis
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
URL_SIGNING_SECRET=troque-este-segredo

PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=2048
STORAGE_QUOTA_MB=10240
