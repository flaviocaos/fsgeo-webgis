# Endereço público da API FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
# "supabase" (produção) ou "local" (desenvolvimento com usuário único definido no backend)
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mapa-base vetorial (estilo MapLibre). Padrão: OpenFreeMap, baseado em OpenStreetMap, sem chave.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Imagem de satélite (XYZ). Ex.: MapTiler https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=SUA_CHAVE
NEXT_PUBLIC_SATELLITE_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
